# ----------------------------------------------------------------------
#     Example environment variables file
#     Copy this file as .env and fill in the required values
# ----------------------------------------------------------------------

# -------------------- 1. General configuration (always required) --------------------
# Execution mode (False for development, True for production)
PRODUCTION=False

# -------------------- 2. Required variables by mode --------------------
# --- Production ---
# Production bot token (required if PRODUCTION=True)
DISCORD_BOT_TOKEN=

# --- Testing/Development ---
# Testing bot token (required if PRODUCTION=False)
TESTING_DISCORD_BOT_TOKEN=
# Testing server ID (required if PRODUCTION=False)
TESTING_GUILD_ID=

# -------------------- 3. Integrations and external APIs --------------------
# Base URL for the REST API (adjust to your environment)
API_REST=http://localhost:8000/

# URL to get the latest GitHub release (usually does not require changes)
RELEASES_URL=https://api.github.com/repos/<USERNAME>/<REPO_NAME>/releases/latest
# Personal GitHub token (optional, for authenticating GitHub API requests)
GITHUB_TOKEN=
